{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Task 469 item 5b. Two disjoint compilation units (see DEVELOPMENT.md "Layout"), each
  // declared as its own knip workspace so import resolution + each package.json's dependency
  // list is checked against the right tree.
  //
  // test/vscode-e2e (own package.json/lockfile, Playwright's own devDependency incl. `vscode`
  // as a peer-ish type-only import) and the .worktrees/ scratch checkouts other agents create
  // were originally excluded here via `ignoreWorkspaces` + a top-level `ignoreDependencies:
  // ["vscode"]` safety net, on the theory that knip would auto-discover them as implicit
  // workspaces and report a spurious "unlisted dependency: vscode". Task 498 re-verified this:
  // removing both hints one at a time produced NO new findings — root package.json has no
  // `"workspaces"` field, so knip's auto-discovery never actually reaches either directory in
  // the first place. Both hints are gone. If root package.json ever gains a `"workspaces"`
  // field, re-check this before assuming it still holds.
  //
  // playwright is media-src's/test/vscode-e2e's devDependency, invoked from CI workflow YAML
  // (`npx playwright ...`) that neither workspace's project/entry globs cover.
  "ignoreBinaries": ["playwright"],
  // Per-export suppression: an export carrying a `/** @knipignore */` JSDoc tag is excluded from
  // the unused-exports report, while every OTHER export in the same file stays analysed. Use this
  // instead of an `ignore` entry whenever only SOME of a file's exports are false positives — a
  // whole-file ignore blinds knip to that file permanently (task 498; the one live user is
  // `graphvizRender` in src/diagrams/graphviz-render.ts, whose only consumer is a relative path
  // baked into a string by esbuild-shared.mjs's patchGraphvizRender, so there is no import edge).
  "tags": ["-knipignore"],
  "workspaces": {
    ".": {
      // No explicit `entry` needed: knip's default entry heuristic derives it from
      // package.json's `main` (out/app/extension.js → src/app/extension.ts), and the
      // redundant explicit pattern was itself a knip config hint (task 498).
      "project": ["src/**/*.ts", "test/backend/**/*.ts", "test/parity/**/*.ts"],
      "ignore": [
        // test/backend/vscode-mock.ts deliberately mirrors the REAL `vscode` namespace shape
        // (DocumentSymbol, languages, SymbolKind, TreeItemCollapsibleState.Collapsed) even where
        // nothing currently exercises every member — the mock is more useful complete than
        // minimal (task 498; see the file's own header comment). Not dead code to trim.
        "test/backend/vscode-mock.ts"
      ],
      "ignoreDependencies": [
        // test/backend reads media-src/node_modules/vditor/src/**/*.ts as TEXT (readFileSync,
        // not an import) to check patch anchors still exist — see
        // test/backend/vditor-source-patches.test.ts and patch-mutation.test.ts. knip's
        // string-literal heuristic flags the path substring as dependency usage even though
        // it's not a module import; vditor is media-src's dependency, not this workspace's.
        "vditor",
        // False positive from an npm script value (`"harness:serve": "... node
        // media-src/e2e/serve.mjs"` etc.) — knip's binary/script-token scan reads the
        // "media-src" path segment as a package reference. There's no such npm package.
        "media-src",
        // @types/vscode is types-only: the `vscode` module itself is never an installable npm
        // package (injected by the Extension Host at runtime), so knip can't link the `import
        // ... from 'vscode'` usage back to the declared @types/vscode devDependency the way it
        // does for a normal @types/* package with a same-named runtime counterpart.
        "@types/vscode"
      ]
    },
    "media-src": {
      "entry": [
        // The 4 esbuild entry points nothing imports (see DEVELOPMENT.md "Webview bundle").
        "src/boot/main.ts",
        "src/diagrams/d2/elk-entry.ts",
        "src/diagrams/d2/d2-entry.ts",
        "src/diagrams/mermaid/mermaid-elk-entry.ts",
        // Each e2e harness is its own esbuild entry (serve.mjs), loaded by URL not import.
        "e2e/*-harness.ts",
        "e2e/harness.ts"
      ],
      "project": ["src/**/*.ts", "e2e/**/*.ts"],
      "ignore": [
        // Loaded by esbuild-shared.mjs via `new URL(...)` (a toolbar-stub replacement plugin),
        // not a static import — no import edge for knip to find. See DEVELOPMENT.md.
        "src/chrome/stubs/vditor-toolbar-stubs.ts",
        // NOTE: src/diagrams/graphviz-render.ts is deliberately NOT listed here. Only ONE of its
        // three exports (`graphvizRender`) is a false positive; a whole-file ignore would also
        // blind knip to `themeGraphvizSvg`/`applyGraphvizTheme` forever. It carries a per-export
        // `@knipignore` tag instead — see the `tags` setting at the top of this file (task 498).
        // Ambient `declare module` types (*.scss/*.png/*.jpg/*.svg) — picked up by the TS
        // compiler via tsconfig `include`, never imported by name. Also excluded from unit
        // coverage for the same reason (test/vitest.config.ts, check-coverage-modules.mjs).
        "src/util/types.ts"
      ],
      "ignoreDependencies": [
        // Provides only the `playwright-cli` binary (media-src/node_modules/.bin/), invoked
        // directly by the `pw:cli` npm script — never imported as a module.
        "@playwright/cli",
        // The five below are LIVE dependencies knip structurally cannot see (task 471, task 498):
        // each is consumed only via a media-src/scripts/fetch-*.mjs
        // `esbuild.build({ stdin: { contents: … } })` call — the "import" is a JS template
        // string, not a parsed import statement — and d3 additionally by the vendored
        // mermaid-layout-elk chunk at build time. They are ignored HERE (rather than left as
        // permanent red findings) so `npm run knip` exits 0 and can gate CI: with a green
        // baseline, any new finding is unambiguously the author's. Do NOT remove any of them
        // from media-src/package.json without re-reading
        // tasks/done/471-dead-vendored-devdependencies.md first — removal makes the vendored
        // bundles unregenerable. (markmap-lib/markmap-view were the genuinely-dead cases and
        // are already gone, task 481.)
        "d3",
        "three",
        "vega",
        "vega-embed",
        "vega-lite"
      ]
    }
  }
}
